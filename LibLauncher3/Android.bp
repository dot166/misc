android_library {
    name: "LibLauncher3",
    static_libs: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "androidx.appcompat_appcompat",
        "kotlin-parcelize-runtime",
        "kotlin-stdlib",
    ],

    manifest: "src/main/AndroidManifest.xml",

    srcs: [
        "src/main/java/**/*.kt",
        "src/main/java/**/*.java",
        "src/main/aidl/**/*.aidl",
    ],

    aidl: {
        local_include_dirs: ["src/main/aidl"],
    },

    resource_dirs: [
        "src/main/res",
    ],
    use_resource_processor: true,

    kotlincflags: ["-Xjvm-default=all", "-Xplugin=${config.KotlinParcelizePlugin}"],
    sdk_version: "current",
    min_sdk_version: "31",
}
