android_app {
    name: "Nexus",
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,
    static_libs: [
        "j-Lib",
        "androidx.lifecycle_lifecycle-service",
    ],

    manifest: "AndroidManifest.xml",

    srcs: [
        "java/**/*.kt",
        "java/**/*.java",
        "aidl/**/*.aidl",
    ],

    aidl: {
        local_include_dirs: ["aidl"],
    },

    resource_dirs: [
        "res",
    ],

    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "31",
    required: [
        "io.github.dot166.nexus.xml",
    ],
}

prebuilt_etc {
    name: "io.github.dot166.nexus.xml",
    src: "data/io.github.dot166.nexus.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
