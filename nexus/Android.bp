android_app {
    name: "Nexus",
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,
    static_libs: [
        "j-Lib",
        "androidx.lifecycle_lifecycle-service",
    ],

    manifest: "AndroidManifest.xml",

    srcs: [
        "java/**/*.kt",
        "java/**/*.java",
        "aidl/**/*.aidl",
    ],

    aidl: {
        local_include_dirs: ["aidl"],
    },

    resource_dirs: [
        "res",
    ],

    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "31",
}
